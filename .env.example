# WanderWise — all keys via env, never hard-coded
# Copy to .env for local dev

# Frontend
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_NAME=WanderWise
VITE_APP_VERSION=0.1.0-scaffold

# Firebase (optional — only if you enable cross-device sync)
# Guests can use the app without signing in; sign-in adds sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=asia-south1
VITE_RECAPTCHA_SITE_KEY=
VITE_USE_EMULATORS=false

# Backend is configured via backend/.env.example (PORT, CORS_ORIGIN, etc.)
