rules_version = '2';

// Spec §6 storage layout:
//   /cities/{cityId}/hero.jpg     public read
//   /pois/{poiId}/photo.jpg       public read
//   /users/{userId}/profile.jpg   owner read/write only
service firebase.storage {
  match /b/{bucket}/o {

    match /cities/{cityId}/{file} {
      allow read: if true;
      allow write: if false; // admin SDK / seed script only
    }

    match /pois/{poiId}/{file} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/{file} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
